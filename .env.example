# CyberShield AI Production Environment Variables
# Copy this file to .env and fill in the values before running docker-compose up -d

# Domain name for your cloud VPS (e.g., cybershield.yourdomain.com or your IP address)
DOMAIN=cybershield.local

# Security Key for FastAPI (Generate a strong random string)
SECRET_KEY=production-cyber-shield-key-2026

# Threat Intelligence APIs (Optional but recommended for full ML capabilities)
VT_API_KEY=your_virustotal_api_key_here
GSB_API_KEY=your_google_safe_browsing_api_key_here

# Supabase PostgreSQL Database (Replace with your actual Supabase Transaction connection string)
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
